{"openapi": "3.0.0", "info": {"title": "Lab API", "version": "1"},
 "servers": [{"url": "http://127.0.0.1:8088"}],
 "components": {"securitySchemes": {"bearer": {"type": "http", "scheme": "bearer"}}},
 "paths": {
  "/api/users": {"get": {"responses": {"200": {"description": "list"}}},
                 "delete": {"responses": {"204": {"description": "deleted"}}}},
  "/api/health": {"get": {"security": [], "responses": {"200": {"description": "ok", "headers": {"X-RateLimit-Limit": {"schema": {"type": "integer"}}}}}}},
  "/api/crash": {"get": {"security": [{"bearer": []}], "responses": {"500": {"description": "returns stack trace for debug"}}}},
  "/api/admin/{id}": {"put": {"security": [{"bearer": []}], "responses": {"200": {"description": "ok", "headers": {"X-RateLimit-Limit": {"schema": {"type": "integer"}}}}}}}
 }}
